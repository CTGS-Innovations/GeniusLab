# Keeps Genius Lab running on the home server. Edit User and WorkingDirectory, then:
#   sudo cp deploy/geniuslab.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now geniuslab
#   journalctl -u geniuslab | grep "family code"
[Unit]
Description=Genius Lab
After=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/projects/GeniusLab
Environment=PORT=4173
# Environment=GL_FAMILY_CODE=123456
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure

[Install]
WantedBy=multi-user.target
